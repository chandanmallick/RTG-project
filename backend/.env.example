# Backend runtime configuration
# Copy values into your server/service environment.

APP_BACKEND_TITLE=ASTRO Backend

# Mongo can be IP based internally or a DNS alias, for example:
# mongodb://mongo.internal.erldc.in:27017/
MONGO_URI=mongodb://10.3.230.60:27017/
MONGO_DB_NAME=rtg_db
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Crew Management hybrid storage. Keep all URI values server-side only.
CREW_LOCAL_MONGO_URI=mongodb://10.3.230.60:27017/
CREW_LOCAL_MONGO_DB_NAME=crew_management
CREW_ATLAS_MONGO_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster>/?appName=CrewApp
CREW_ATLAS_MONGO_DB_NAME=crew_management
# Enable only after scripts/migrate_crew_to_atlas.py --execute verifies counts.
CREW_USE_ATLAS=false

# Set false for local UI/API work when MongoDB or internal network is unavailable.
RUN_SCHEDULER=true

# For same-domain deployment through reverse proxy, keep only your public URL.
# For local development, add http://localhost:3001.
CORS_ALLOW_ORIGINS=https://astro.example.in,http://localhost:3001

# Microsoft Graph mail credentials. Keep these only in the protected server environment.
# Never expose them through VITE_ variables or store them in MongoDB.
CREW_GRAPH_TENANT_ID=
CREW_GRAPH_CLIENT_ID=
CREW_GRAPH_CLIENT_SECRET=
CREW_GRAPH_SENDER=alerts@example.in
CREW_EMAIL_ENABLED=false

# Emergency recovery only: temporarily bypass configured email OTP if the mail
# provider is unavailable and no administrator has an active session.
CREW_2FA_EMERGENCY_OFF=false
